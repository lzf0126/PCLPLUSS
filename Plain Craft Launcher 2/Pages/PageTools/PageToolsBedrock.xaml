<local:MyPageRight x:Class="PCL.PageToolsBedrock"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="Minecraft 基岩版">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                               Text="自动检测本机已安装的 Minecraft 基岩版（UWP 旧版 / GDK 新版），点击右侧按钮即可启动，无需先登录微软账号。" />
                    <StackPanel x:Name="PanList" Margin="0,12,0,0" />
                    <TextBlock x:Name="LabEmpty"
                               Margin="0,14,0,0"
                               Opacity="0.65"
                               Text="未检测到已安装的 Minecraft 基岩版。可先通过 Microsoft Store 安装，或点击下方按钮打开商店页面。"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <WrapPanel Margin="0,18,0,0">
                        <local:MyButton x:Name="BtnRefresh"
                                        MinWidth="110"
                                        Margin="0,0,12,0"
                                        Click="BtnRefresh_Click"
                                        Text="重新扫描" />
                        <local:MyButton MinWidth="170"
                                        Click="BtnStore_Click"
                                        Text="打开 Microsoft Store" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="说明">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock LineHeight="20"
                               Opacity="0.72"
                               TextWrapping="Wrap"
                               Text="• UWP 旧版：Microsoft Store 经典分发的基岩版（Microsoft.MinecraftUWP）&#x0A;• GDK 新版：2025 年后 Store 分发的统一版本（Microsoft.Minecraft）&#x0A;• 启动方式为系统级 shell:appsFolder 调起，不修改游戏文件，也不会影响你的微软账号登录状态&#x0A;• 检测依赖系统 AppX 包信息，若刚安装完商店版本请点「重新扫描」" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
